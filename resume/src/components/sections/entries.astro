---
import type { EntriesSection } from "#/lib/types";
import MainSection from "#/components/ui/main-section.astro";
import Entry from "./entry.astro";

type Props = EntriesSection;

const { title, items } = Astro.props;
---

<MainSection title={title}>
	<div class="flex flex-col gap-3">
		{items.map((item) => (
			<Entry {...item} />
		))}
	</div>
</MainSection>
