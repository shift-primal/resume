---
import Icon from "#/components/ui/icon.astro";
import SideSection from "#/components/ui/side-section.astro";
import type { SkillsSection } from "#/lib/types";

type Props = SkillsSection;

const { title, groups } = Astro.props;
---

<SideSection title={title}>
	<dl class="flex flex-col gap-2.5">
		{groups.map((group) => (
			<div id={group.label}>
				<dt class="flex items-center gap-2 font-semibold">
					<Icon name={group.icon} class="size-[3.2mm] shrink-0" />
					<span>{group.label}</span>
				</dt>
				<dd class="overflow-hidden">
					<ul class="-ml-2.5 flex flex-wrap">
						{group.items.map((skill) => (
							<li class="whitespace-nowrap before:inline-block before:w-2.5 before:text-center before:content-['·']">
								{skill}
							</li>
						))}
					</ul>
				</dd>
			</div>
		))}
	</dl>
</SideSection>
