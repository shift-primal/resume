---
import Icon from "#/components/ui/icon.astro";
import SideSection from "#/components/ui/side-section.astro";
import { splitHyphenated } from "#/lib/format";
import type { SkillsSection } from "#/lib/types";

type Props = SkillsSection;

const { title, groups } = Astro.props;
---

<SideSection title={title}>
	<dl>
		{groups.map((group) => (
			<>
				<dt class="flex items-center gap-2 font-semibold not-first:mt-2">
					<Icon name={group.icon} class="size-[3.2mm] shrink-0" />
					{group.label}
				</dt>
				<dd>
					{group.items.map((skill, i) => (
						<>
							{i > 0 && ", "}
							{splitHyphenated(skill).map((part) =>
								part.hyphenated ? (
									<span class="whitespace-nowrap">
										{part.text}
									</span>
								) : (
									part.text
								),
							)}
						</>
					))}
				</dd>
			</>
		))}
	</dl>
</SideSection>
