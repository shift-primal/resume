---
import type { Cv } from "#/lib/types";

interface Props {
	name: Cv["name"];
	role: Cv["role"];
}

const { name, role } = Astro.props;
---

<header class="col-start-2 row-start-1 h-(--name-height) text-white">
	<h1 class="font-name text-name leading-[1.12] tracking-[0.01em] uppercase [text-box:trim-both_cap_alphabetic]">
		<span class="block font-normal">{name.first}</span>
		<span class="block font-bold">{name.last}</span>
	</h1>
	<p class="mt-5.5 text-role font-light tracking-[0.08em] [text-box:trim-both_cap_alphabetic]">
		{role}
	</p>
</header>
