---
import type { Cv } from "#/lib/types";
import Sidebar from "./sidebar.astro";

interface Props {
	cv: Cv;
}

const { cv } = Astro.props;
---

<!-- Decorative background -->
<div class="header-band"></div>

<div class="layout">
	<!-- ===== Name (right column, inside the header band) ===== -->
	<header class="name-block">
		<h1>
			<span class="first-name">Kasper</span>
			<span class="last-name">Haugestøl</span>
		</h1>
		<p class="role">Fullstack-utvikler</p>
	</header>

	<Sidebar photo={cv.photo} sections={cv.sidebar} />

	<main class="main">
		<section class="main-section">
			<h2>Om meg</h2>
			<p>
				Fullstack-utvikler under utdanning ved GET Academy. Liker best å
				bygge hele løsninger, fra database til grensesnitt, og få dem ut
				i bruk. Ser etter praksisplass eller juniorstilling innen
				webutvikling.
			</p>
		</section>
	</main>
</div>
